{
  "name": "runich-backend",
  "version": "1.5.3",
  "type": "module",
  "description": "Backend service for runich app",
  "author": "Alexander Voronin",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "yarn db:generate && yarn db:sync && NODE_OPTIONS='--import tsx' nest start --watch",
    "start": "yarn db:sync && NODE_OPTIONS='--import tsx' nest start",
    "start:debug": "yarn db:generate && yarn db:sync && NODE_OPTIONS='--import tsx' nest start --debug",
    "start:prod": "node dist/main.js",
    "worker:dev": "yarn db:generate && yarn db:sync && tsx src/app/background-worker.ts",
    "worker:prod": "node --import dotenv/config dist/background-worker.js",
    "model:download:text-moderation": "node scripts/download-text-moderation-model.mjs",
    "build": "tsdown --config tsdown.config.ts",
    "maplibre:smoke": "xvfb-run --auto-servernum --server-args='-screen 0 1280x1024x24' node scripts/maplibre-runtime-smoke.mjs",
    "prepare": "husky",
    "db:generate": "yarn prisma contract emit",
    "db:sync": "node prisma/db-sync.mjs",
    "db:migrate:prod": "node prisma/db-migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:up": "docker compose up -d db --wait && (yarn prisma db sign || yarn db:sync)",
    "db:up:check": "docker compose up -d db --wait && (yarn prisma db sign --no-advance-ref || yarn db:sync)",
    "test": "yarn db:generate && node --max-old-space-size=6144 --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "yarn db:generate && node --max-old-space-size=6144 --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "yarn db:generate && node --max-old-space-size=6144 --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --maxWorkers=50% --no-watchman",
    "test:integration": "yarn db:generate && yarn prisma db verify && RUNICH_INTEGRATION=true node --max-old-space-size=6144 --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand --no-watchman",
    "test:all": "yarn db:generate && yarn db:up && node --max-old-space-size=6144 --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --maxWorkers=50% --no-watchman && yarn prisma db verify && RUNICH_INTEGRATION=true node --max-old-space-size=6144 --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand --no-watchman",
    "deps": "npx npm-check-updates@latest"
  },
  "dependencies": {
    "@ardentcode/sports-lib": "^5.4.29",
    "@aws-sdk/client-s3": "3.1179.0",
    "@aws-sdk/s3-request-presigner": "3.1179.0",
    "@huggingface/transformers": "4.3.2",
    "@mapbox/polyline": "^1.2.1",
    "@maplibre/maplibre-gl-native": "6.5.0-pre.1",
    "@nestjs/common": "12.6.3",
    "@nestjs/core": "12.6.3",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/observe": "0.3.29",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-express": "12.6.3",
    "@nestjs/swagger": "12.1.3",
    "@nestjs/throttler": "6.8.0",
    "@prisma/cli-engine": "0.10.4",
    "@prisma/orm-postgres": "8.0.0-rc.25",
    "@react-email/components": "^1.0.12",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@we-gold/gpxjs": "^1.2.1",
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "blurhash": "^2.0.5",
    "buffer": "^6.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "nsfwjs": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.36",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.8",
    "uuid": "^14.0.3",
    "xmldom-qsa": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.17",
    "@nestjs/testing": "12.6.3",
    "@prisma/management-api-sdk": "^1.106.0",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/passport-jwt": "^4.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "js-yaml": "^5.5.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "resolutions": {
    "body-parser@npm:^2.3.0": "npm:^2.4.0",
    "brace-expansion@npm:^1.1.7": "npm:^1.1.20",
    "brace-expansion@npm:^2.0.2": "npm:^2.1.6",
    "brace-expansion@npm:^5.0.12": "npm:^5.0.11",
    "brace-expansion@npm:^5.0.8": "npm:^5.0.11",
    "fast-uri@npm:^3.0.1": "npm:^3.1.7",
    "js-yaml@npm:^3.13.1": "npm:^3.15.2",
    "js-yaml@npm:^3.14.1": "npm:^3.15.2",
    "nanoid@npm:^3.3.16": "npm:^3.3.18",
    "source-map-js@npm:^1.2.1": "npm:^1.2.2",
    "undici@npm:^8.4.1": "npm:^8.12.2"
  },
  "packageManager": "yarn@4.19.0",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --config .prettierrc --write"
    ]
  }
}
