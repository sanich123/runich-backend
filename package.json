{
  "name": "runich-backend",
  "version": "1.2.1",
  "type": "module",
  "description": "Backend service for runich app",
  "author": "Alexander Voronin",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "yarn db:generate && yarn db:sync && tsx watch src/main.ts",
    "start": "yarn db:sync && nest start",
    "start:debug": "yarn db:generate && yarn db:sync && node --inspect --import tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "worker:dev": "yarn db:generate && yarn db:sync && tsx src/app/background-worker.ts",
    "worker:prod": "node dist/background-worker.js",
    "build": "tsdown --config tsdown.config.ts",
    "maplibre:smoke": "xvfb-run --auto-servernum --server-args='-screen 0 1280x1024x24' node scripts/maplibre-runtime-smoke.mjs",
    "prepare": "husky",
    "db:generate": "yarn prisma contract emit",
    "db:sync": "node prisma/db-sync.mjs",
    "db:migrate:prod": "node prisma/db-migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "load-test:prepare": "tsx prisma/prepare-load-test-assets.ts",
    "db:up": "docker compose up -d db --wait && (yarn prisma db sign || yarn db:sync)",
    "db:up:check": "docker compose up -d db --wait && (yarn prisma db sign --no-advance-ref || yarn db:sync)",
    "test": "yarn db:generate && jest",
    "test:watch": "yarn db:generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:ci": "yarn db:generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --passWithNoTests --no-watchman",
    "test:cov": "yarn db:generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand --no-watchman",
    "test:integration": "yarn db:generate && yarn db:sync && RUNICH_INTEGRATION=true node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand --no-watchman",
    "test:all": "yarn db:up && yarn test:ci && yarn test:cov && yarn test:integration",
    "typecheck": "yarn db:generate && tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --config .prettierrc --write './src/**/*.{ts,tsx}'",
    "madge": "madge --ts-config ./tsconfig.json --warning --circular --extensions ts ./src",
    "ts-prune": "ts-prune --ignore 'src/infrastructure|^prisma/|(^|/)generated/|(^|/)(migrations|snapshots)/|\\.d\\.ts$|prisma\\.config\\.ts|\\.spec\\.ts$'",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@ardentcode/sports-lib": "^5.4.29",
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@mapbox/polyline": "^1.2.1",
    "@maplibre/maplibre-gl-native": "6.5.0-pre.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/observe": "0.3.16",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "patch:@nestjs/throttler@npm%3A6.5.0#~/.yarn/patches/@nestjs-throttler-npm-6.5.0-b1c890481d.patch",
    "@prisma/cli-engine": "0.9.0",
    "@prisma/orm-postgres": "8.0.0-rc.19",
    "@react-email/components": "^1.0.12",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@we-gold/gpxjs": "^1.2.0",
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "blurhash": "^2.0.5",
    "buffer": "^6.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.0",
    "nsfwjs": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tcx-js": "^1.0.1",
    "temporal-polyfill": "^1.0.6",
    "uuid": "^14.0.3",
    "xmldom-qsa": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@prisma/management-api-sdk": "^1.84.0",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "js-yaml": "^5.5.0",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-prune": "^0.10.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@prisma/orm-toolchain": "8.0.0-rc.19"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --config .prettierrc --write"
    ]
  }
}
