{
  "name": "runich-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "author": "Alexander Voronin",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "nest start",
    "dev": "tsx watch src/main.ts",
    "db:up": "docker compose up -d db --wait && yarn prisma migrate deploy",
    "start:debug": "node --inspect --import tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "start:migrate:prod": "prisma migrate deploy && node dist/main.js",
    "start:migrate:dev": "prisma generate && prisma migrate deploy && yarn dev",
    "build": "tsup --config tsup.config.json",
    "test": "jest",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --passWithNoTests --no-watchman",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "prepare": "husky",
    "lint": "eslint src --fix",
    "format": "prettier --config .prettierrc --write './src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "madge": "madge --ts-config ./tsconfig.json --warning --circular --extensions ts --exclude 'generated' ./src",
    "ts-prune": "ts-prune --ignore 'src/infrastructure|src/generated|prisma.config.ts|tsup.config.ts|\\.spec\\.ts$'",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@ardentcode/sports-lib": "^5.4.29",
    "@mapbox/polyline": "^1.2.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@we-gold/gpxjs": "^1.2.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "blurhash": "^2.0.5",
    "class-transformer": "0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.2",
    "husky": "^9.1.7",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma-better-errors": "^1.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "tcx-js": "^1.0.1",
    "uuid": "^14.0.1",
    "xmldom-qsa": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11.1.29",
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "depcheck": "^1.4.7",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "js-yaml": "^5.3.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@4.18.0"
}
