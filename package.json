{
  "name": "runich-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "author": "Alexander Voronin",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "yarn migrate && nest start",
    "dev": "yarn prisma generate && yarn migrate && tsx watch src/main.ts",
    "start:dev": "yarn dev",
    "migrate": "yarn prisma migrate deploy",
    "db:up": "docker compose up -d db --wait && yarn migrate",
    "start:debug": "yarn prisma generate && yarn migrate && node --inspect --import tsx src/main.ts",
    "start:prod": "yarn migrate && node dist/main.js",
    "start:migrate:prod": "yarn start:prod",
    "start:migrate:dev": "yarn dev",
    "build": "tsup --config tsup.config.json",
    "test": "yarn prisma generate && jest",
    "test:ci": "yarn prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --passWithNoTests --no-watchman",
    "test:watch": "yarn prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "yarn prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand --no-watchman",
    "test:integration": "yarn prisma generate && yarn migrate && RUNICH_INTEGRATION=true node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand --no-watchman",
    "test:all": "yarn db:up && yarn test:ci && yarn test:cov && yarn test:integration",
    "prepare": "husky",
    "lint": "eslint src integration --fix",
    "format": "prettier --config .prettierrc --write './src/**/*.{ts,tsx}' './integration/**/*.ts'",
    "typecheck": "yarn prisma generate && tsc --noEmit",
    "madge": "madge --ts-config ./tsconfig.json --warning --circular --extensions ts --exclude 'generated' ./src",
    "ts-prune": "ts-prune --ignore 'src/infrastructure|src/generated|prisma.config.ts|tsup.config.ts|\\.spec\\.ts$'",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@ardentcode/sports-lib": "^5.4.29",
    "@mapbox/polyline": "^1.2.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "patch:@nestjs/throttler@npm%3A6.5.0#~/.yarn/patches/@nestjs-throttler-npm-6.5.0-b1c890481d.patch",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@we-gold/gpxjs": "^1.2.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "blurhash": "^2.0.5",
    "class-transformer": "0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.2",
    "husky": "^9.1.7",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma-better-errors": "^1.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "tcx-js": "^1.0.1",
    "uuid": "^14.0.2",
    "xmldom-qsa": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "^1.16.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "depcheck": "^1.4.7",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "js-yaml": "^5.4.1",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "yarn@4.18.0"
}
