        "sql": "CREATE TABLE \"public\".\"Subscriptions\" (\n  \"cancel_at_period_end\" bool DEFAULT false NOT NULL,\n  \"created_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"expires_at\" timestamptz(6),\n  \"id\" uuid DEFAULT (gen_random_uuid()) NOT NULL,\n  \"product_id\" character varying(128),\n  \"provider\" character varying(32) DEFAULT 'manual' NOT NULL,\n  \"provider_subscription_id\" character varying(255),\n  \"starts_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"status\" character varying(24) DEFAULT 'active' NOT NULL,\n  \"updated_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"user_id\" uuid NOT NULL,\n  CONSTRAINT \"Subscriptions_pkey\" PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
