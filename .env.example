DATABASE_URL=postgresql://runich:local-password@localhost:5432/runich_db?schema=public
DATABASE_URL_DOCKER=postgresql://runich:local-password@db:5432/runich_db?schema=public
POSTGRES_USER=runich
POSTGRES_PASSWORD=local-password
POSTGRES_DB=runich_db

PORT=3000
APP_ENV=local
JWT_SECRET=replace-with-a-local-secret
RUNICH_PROCESS=api
SUPERUSER_EMAILS=runich.app@yandex.ru,varon-in@yandex.ru,aovoronin.piano@gmail.com

# Необязательная пара NestJS Observe. Для включения телеметрии нужны оба значения.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Токен записи в Grafana Cloud Logs; обязателен для Alloy при развертывании на Timeweb.
# GRAFANA_LOKI_TOKEN=

# Необязательные настройки защищенной загрузки тестовых данных локально и на Stage.
# LOAD_TEST_SEED_TOKEN=replace-with-a-long-random-token
# LOAD_TEST_ASSET_MANIFEST_KEY=load-test/stage-feed-v1/manifest.json

MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token
# Обязательная конечная точка S3. Регион ru-1 задан в коде бэкенда.
S3_ENDPOINT=https://s3.twcstorage.ru
# Stage и Production используют общий бакет runich-stage для карантинных объектов.
S3_BUCKET=replace-with-timeweb-bucket-name
S3_QUARANTINE_BUCKET=runich-stage
# Для Stage используйте moderation-quarantine/stage/, для Production — moderation-quarantine/production/.
S3_QUARANTINE_PREFIX=moderation-quarantine/stage/
S3_ACCESS_KEY=replace-with-timeweb-access-key
S3_SECRET_ACCESS_KEY=replace-with-timeweb-secret-key
# Нужен только если при создании тестовых данных требуется создать учетную запись владельца.
MOCK_SEED_TARGET_PASSWORD=replace-with-a-strong-password
# Необязательный CDN или собственный публичный URL. По умолчанию используются S3_ENDPOINT и S3_BUCKET.
# S3_PUBLIC_URL=https://s3.twcstorage.ru/replace-with-timeweb-bucket-name
# Необязательный URL собственной модели NSFWJS model.json; если он не задан, используется встроенная модель.
# NSFWJS_MODEL_URL=
# Используется только при APP_ENV=production; после 950 изображений в UTC-месяце включается NSFWJS.
# GOOGLE_CLOUD_VISION_API_KEY=

# SMTP Яндекс Почты: используйте пароль приложения, а не обычный пароль учетной записи.
YANDEX_SMTP_USER=Runich.app@ya.ru
YANDEX_SMTP_PASSWORD=replace-with-yandex-mail-application-password

# Обязательный резервный SMTP Mail.ru для Production и Stage: используйте пароль внешнего приложения.
MAILRU_SMTP_USER=runich-app@mail.ru
MAILRU_SMTP_PASSWORD=replace-with-mailru-external-application-password

YANDEX_CLIENT_ID=replace-with-yandex-client-id
YANDEX_CLIENT_SECRET=replace-with-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:3000/auth/yandex/callback
AUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/login-from-url

VK_CLIENT_ID=replace-with-vk-client-id
VK_REDIRECT_URI=http://localhost:3000/auth/vk/callback
