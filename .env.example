DATABASE_URL=postgresql://runich:local-password@localhost:5432/runich_db?schema=public
DATABASE_URL_DOCKER=postgresql://runich:local-password@db:5432/runich_db?schema=public
POSTGRES_USER=runich
POSTGRES_PASSWORD=local-password
POSTGRES_DB=runich_db

PORT=3000
NODE_ENV=development
SWAGGER_ENABLED=true
SWAGGER_USER=local-docs-user
SWAGGER_PASSWORD=change-me
JWT_SECRET=replace-with-a-local-secret
IS_DEV=true
SEED_MOCK_DATA=false

MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token
MIGRATION_ARCHIVE_DIRECTORY=./dist/receivedArchive
MIGRATION_ACTIVITY_BATCH_SIZE=8
MIGRATION_BATCH_PAUSE_MS=25
MIGRATION_WORKER_POLL_INTERVAL_MS=10000
MIGRATION_WORKER_CPUS=0.50
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_SECRET=replace-with-google-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token
USER_EMAIL=replace-with-sender-email
EMAIL_API_TIMEOUT=15000

VK_CLIENT_ID=replace-with-vk-client-id
VK_CLIENT_SECRET=replace-with-vk-client-secret
VK_REDIRECT_URI=http://localhost:3000/auth/vk/callback
VK_FRONTEND_REDIRECT_URI=http://localhost:5173/login-from-url
