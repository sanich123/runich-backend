logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "runich" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "runich" {
  targets = discovery.docker.runich.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "^(nestjs_app|background_worker|nginx)$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("RUNICH_ENV")
  }

  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
}

loki.source.docker "runich" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.runich.output
  labels     = { job = "runich/backend" }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-012.grafana.net/loki/api/v1/push"

    basic_auth {
      username = "1817257"
      password = sys.env("GRAFANA_LOKI_TOKEN")
    }
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")

    basic_auth {
      username = sys.env("GRAFANA_METRICS_USERNAME")
      password = sys.env("GRAFANA_METRICS_TOKEN")
    }
  }
}

prometheus.scrape "runich_backend" {
  targets = [
    {
      "__address__" = "nestjs_app:3000",
      "environment" = sys.env("RUNICH_ENV"),
      "job"         = "runich/backend",
      "service"     = "nestjs_app",
    },
  ]

  metrics_path    = "/metrics"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}
