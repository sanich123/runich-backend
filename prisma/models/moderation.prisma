// use prisma-8

model ContentReport {
  id                  Uuid                    @id @default(sql`gen_random_uuid()`)
  reporterId          Uuid?                   @map("reporter_id")
  targetType          ContentReportTargetType  @map("target_type")
  targetId            Uuid                    @map("target_id")
  activityId          Uuid?                   @map("activity_id")
  commentId           Uuid?                   @map("comment_id")
  mediaId             Uuid?                   @map("media_id")
  mediaUploadId       Uuid?                   @map("media_upload_id")
  targetUserId        Uuid?                   @map("target_user_id")
  subjectUserId       Uuid?                   @map("subject_user_id")
  reason              ContentReportReason
  details             VarChar(1000)?
  status              ContentReportStatus     @default(open)
  priority            ModerationPriority      @default(normal)
  assignedModeratorId Uuid?                   @map("assigned_moderator_id")
  createdAt           TimestamptzString(6)    @default(now()) @map("created_at")
  reviewedAt          TimestamptzString(6)?   @map("reviewed_at")
  reporter            User?                   @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  subjectUser         User?                   @relation("ContentReportSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  assignedModerator   User?                   @relation("ContentReportAssignee", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  targetUser          User?                   @relation("ContentReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  activity            Activity?               @relation("ContentReportActivity", fields: [activityId], references: [id], onDelete: SetNull)
  comment             Comment?                @relation("ContentReportComment", fields: [commentId], references: [id], onDelete: SetNull)
  media               ActivityMedia?          @relation("ContentReportMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  mediaUpload         MediaModerationAsset?   @relation(fields: [mediaUploadId], references: [id], onDelete: SetNull)
  actions             ModerationAction[]
  appeals             ModerationAppeal[]

  @@index([status, priority, createdAt], map: "ContentReport_status_priority_createdAt_idx")
  @@index([assignedModeratorId, status, createdAt], map: "ContentReport_assignee_status_createdAt_idx")
  @@index([reporterId, createdAt], map: "ContentReport_reporter_createdAt_idx")
  @@index([subjectUserId, createdAt], map: "ContentReport_subject_createdAt_idx")
  @@index([targetType, targetId], map: "ContentReport_target_idx")
  @@index([mediaUploadId], map: "ContentReport_media_upload_id_idx")
  @@map("ContentReport")
}

model MediaModerationAsset {
  id                  Uuid                  @id @default(sql`gen_random_uuid()`)
  ownerId             Uuid                  @map("owner_id")
  mediaId             VarChar(100)          @map("media_id")
  role                VarChar(16)           @default("media")
  scope               VarChar(16)           @default("activity")
  quarantineKey       VarChar(2048)          @map("quarantine_key")
  publishedKey        VarChar(2048)?         @map("published_key")
  contentType         VarChar(255)           @map("content_type")
  byteSize            Int                   @map("byte_size")
  status              MediaModerationStatus @default(queued)
  scores              Jsonb?
  frameCount          Int?                  @map("frame_count")
  modelVersion        VarChar(100)?          @map("model_version")
  attempts            Int                   @default(0)
  processingStartedAt TimestamptzString(6)?  @map("processing_started_at")
  scannedAt           TimestamptzString(6)?  @map("scanned_at")
  reviewedAt          TimestamptzString(6)?  @map("reviewed_at")
  reviewerId          Uuid?                 @map("reviewer_id")
  reviewNote          VarChar(1000)?         @map("review_note")
  createdAt           TimestamptzString(6)  @default(now()) @map("created_at")
  owner               User                  @relation("MediaModerationAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer            User?                 @relation("MediaModerationAssetReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  activityMedia       ActivityMedia?         @relation("ActivityMediaMediaAsset")
  thumbnailForActivityMedia ActivityMedia?    @relation("ActivityMediaThumbnailAsset")
  reports             ContentReport[]

  @@unique([ownerId, mediaId, role], map: "MediaModerationAsset_owner_media_role_key")
  @@index([status, createdAt], map: "MediaModerationAsset_status_created_at_idx")
  @@index([ownerId, createdAt], map: "MediaModerationAsset_owner_created_at_idx")
  @@map("MediaModerationAsset")
}

model GoogleVisionMonthlyUsage {
  monthKey  VarChar(7) @id @map("month_key")
  usedUnits Int        @default(0) @map("used_units")

  @@map("GoogleVisionMonthlyUsage")
}

model ModerationAction {
  id        Uuid                 @id @default(sql`gen_random_uuid()`)
  reportId  Uuid                 @map("report_id")
  actorId   Uuid?                @map("actor_id")
  action    ModerationActionType
  note      VarChar(1000)?
  createdAt TimestamptzString(6) @default(now()) @map("created_at")
  report    ContentReport        @relation(fields: [reportId], references: [id], onDelete: Restrict)
  actor     User?                @relation("ModerationActionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt], map: "ModerationAction_report_createdAt_idx")
  @@index([actorId, createdAt], map: "ModerationAction_actor_createdAt_idx")
  @@map("ModerationAction")
}

model ModerationAppeal {
  id             Uuid                    @id @default(sql`gen_random_uuid()`)
  reportId       Uuid                    @map("report_id")
  appellantId    Uuid?                   @map("appellant_id")
  reason         VarChar(1000)
  status         ModerationAppealStatus   @default(pending)
  createdAt      TimestamptzString(6)     @default(now()) @map("created_at")
  reviewedAt     TimestamptzString(6)?    @map("reviewed_at")
  reviewerId     Uuid?                   @map("reviewer_id")
  resolutionNote VarChar(1000)?           @map("resolution_note")
  report         ContentReport            @relation(fields: [reportId], references: [id], onDelete: Restrict)
  appellant      User?                    @relation("ModerationAppealAppellant", fields: [appellantId], references: [id], onDelete: SetNull)
  reviewer       User?                    @relation("ModerationAppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "ModerationAppeal_status_createdAt_idx")
  @@index([reportId, createdAt], map: "ModerationAppeal_report_createdAt_idx")
  @@map("ModerationAppeal")
}
