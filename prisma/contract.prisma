  appellant      User?                    @relation("ModerationAppealAppellant", fields: [appellantId], references: [id], onDelete: SetNull)
  reviewer       User?                    @relation("ModerationAppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "ModerationAppeal_status_createdAt_idx")
  @@index([reportId, createdAt], map: "ModerationAppeal_report_createdAt_idx")
  @@map("ModerationAppeal")
}

