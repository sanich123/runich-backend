}

model LoadTestSeedJob {
  id                  Uuid                  @id(map: "LoadTestSeedJob_pkey") @default(sql`gen_random_uuid()`)
  runId               VarChar(64)           @unique(map: "LoadTestSeedJob_runId_key") @map("run_id")
  targetUserId        Uuid                  @map("target_user_id")
  manifestKey         VarChar(512)          @map("manifest_key")
  config              Jsonb
  status              VarChar(32)
  totalUsers          Int                   @default(0) @map("total_users")
  totalActivities     Int                   @default(0) @map("total_activities")
  processedActivities Int                   @default(0) @map("processed_activities")
  createdActivities   Int                   @default(0) @map("created_activities")
  createdLikes        Int                   @default(0) @map("created_likes")
  createdComments     Int                   @default(0) @map("created_comments")
  createdCommentLikes Int                   @default(0) @map("created_comment_likes")
  errorMessage        String?               @map("error_message")
  createdAt            TimestamptzString(6)  @default(now()) @map("created_at")
  startedAt            TimestamptzString(6)? @map("started_at")
  finishedAt           TimestamptzString(6)? @map("finished_at")

  @@index([status, createdAt], map: "LoadTestSeedJob_status_createdAt_idx")
  @@map("LoadTestSeedJob")
}

model EmailNotificationJob {
  id               Uuid                 @id @default(sql`gen_random_uuid()`)
  notificationType VarChar(24)           @map("notification_type")
  sourceId         Uuid                 @map("source_id")
  status           VarChar(16)           @default("queued")
  attempts         Int                  @default(0)
  availableAt      TimestamptzString(6)  @default(now()) @map("available_at")
  errorMessage     String?              @map("error_message")
  createdAt        TimestamptzString(6)  @default(now()) @map("created_at")
  startedAt        TimestamptzString(6)? @map("started_at")
  finishedAt       TimestamptzString(6)? @map("finished_at")

  @@unique([notificationType, sourceId], map: "EmailNotificationJob_notification_type_source_id_key")
  @@index([status, availableAt, createdAt], map: "EmailNotificationJob_status_available_at_created_at_idx")
  @@map("EmailNotificationJob")
}

model Notification {
  id               Uuid                  @id @default(sql`gen_random_uuid()`)
  recipientUserId  Uuid                  @map("recipient_user_id")
  actorUserId      Uuid?                 @map("actor_user_id")
  type             VarChar(64)
  sourceId         Uuid                  @map("source_id")
  targetType       VarChar(32)           @map("target_type")
  targetId         Uuid                  @map("target_id")
  relatedId        Uuid?                 @map("related_id")
  actorName        String?               @map("actor_name")
  actorSurname     String?               @map("actor_surname")
  actorProfilePhoto String?              @map("actor_profile_photo")
  content          String?
  inApp            Boolean               @default(true) @map("in_app")
  createdAt        TimestamptzString(6)  @default(now()) @map("created_at")
  readAt           TimestamptzString(6)? @map("read_at")
  recipient        User                  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade, map: "Notification_recipient_user_id_fkey")
  actor            User?                 @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull, map: "Notification_actor_user_id_fkey")
  pushJob          PushNotificationJob?

  @@unique([recipientUserId, type, sourceId], map: "Notification_recipient_type_source_key")
  @@index([recipientUserId, createdAt, id], map: "Notification_recipient_createdAt_id_idx")
  @@index([recipientUserId, readAt], map: "Notification_recipient_readAt_idx")
  @@map("Notification")
}

model PushDeviceToken {
  id        Uuid                 @id @default(sql`gen_random_uuid()`)
  userId    Uuid                 @map("user_id")
  deviceId  VarChar(128)         @unique(map: "PushDeviceToken_device_id_key") @map("device_id")
  token     VarChar(512)         @unique(map: "PushDeviceToken_token_key")
  platform  VarChar(32)
  active    Boolean              @default(true)
  createdAt TimestamptzString(6) @default(now()) @map("created_at")
  updatedAt TimestamptzString(6) @default(now()) @map("updated_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PushDeviceToken_user_id_fkey")

  @@index([userId, active], map: "PushDeviceToken_user_active_idx")
  @@map("PushDeviceToken")
}

model PushNotificationJob {
  id             Uuid                  @id @default(sql`gen_random_uuid()`)
  notificationId Uuid                  @unique(map: "PushNotificationJob_notification_id_key") @map("notification_id")
  status         VarChar(16)           @default("queued")
  attempts       Int                   @default(0)
  availableAt    TimestamptzString(6)  @default(now()) @map("available_at")
  errorMessage   String?               @map("error_message")
  createdAt      TimestamptzString(6)  @default(now()) @map("created_at")
  startedAt      TimestamptzString(6)? @map("started_at")
  finishedAt     TimestamptzString(6)? @map("finished_at")
  notification   Notification          @relation(fields: [notificationId], references: [id], onDelete: Cascade, map: "PushNotificationJob_notification_id_fkey")

  @@index([status, availableAt, createdAt], map: "PushNotificationJob_status_available_at_created_at_idx")
  @@map("PushNotificationJob")
}

model UserSession {
  id             Uuid                  @id(map: "UserSession_pkey") @default(sql`gen_random_uuid()`)
  userId         Uuid                  @map("user_id")
  refreshHash    VarChar(128)          @map("refresh_hash")
  deviceId       VarChar(128)          @map("device_id")
  deviceName     VarChar(255)?         @map("device_name")
  platform       VarChar(64)?
  deviceModel    VarChar(128)?         @map("device_model")
  manufacturer   VarChar(128)?
  osName         VarChar(64)?          @map("os_name")
  osVersion      VarChar(64)?          @map("os_version")
  deviceType     VarChar(64)?          @map("device_type")
  appVersion     VarChar(32)?          @map("app_version")
  appBuild       VarChar(32)?          @map("app_build")
  userAgent      VarChar(512)?         @map("user_agent")
  ipAddress      VarChar(128)?         @map("ip_address")
  lastSeenAt     TimestamptzString(6)  @default(now()) @map("last_seen_at")
  lastLatitude   Float?                @map("last_latitude")
  lastLongitude  Float?                @map("last_longitude")
  lastLocationAt TimestamptzString(6)? @map("last_location_at")
  createdAt      TimestamptzString(6)  @default(now()) @map("created_at")
  revokedAt      TimestamptzString(6)? @map("revoked_at")
  user           User                  @relation(fields:[userId], references:[id], onDelete: Cascade, map: "UserSession_user_id_fkey")

  @@unique([refreshHash], map: "UserSession_refresh_hash_key")
  @@index([userId, deviceId], map: "UserSession_user_id_device_id_idx")
  @@index([userId], map: "UserSession_user_id_idx")
  @@map("UserSession")
}
