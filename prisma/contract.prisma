}

model Subscription {
  id                       Uuid                  @id(map: "Subscriptions_pkey") @default(sql`gen_random_uuid()`)
  userId                   Uuid                  @map("user_id")
  provider                 VarChar(32)           @default("manual")
  providerSubscriptionId   VarChar(255)?         @map("provider_subscription_id")
  productId                VarChar(128)?         @map("product_id")
  status                   VarChar(24)           @default("active")
  startsAt                 TimestamptzString(6)  @default(now()) @map("starts_at")
  expiresAt                TimestamptzString(6)? @map("expires_at")
  cancelAtPeriodEnd        Boolean               @default(false) @map("cancel_at_period_end")
  createdAt                TimestamptzString(6)  @default(now()) @map("created_at")
  updatedAt                TimestamptzString(6)  @default(now()) @map("updated_at")
