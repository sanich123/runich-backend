  instanceId               Uuid?                  @map("instance_id")
  aud                      VarChar(255)?
  role                     VarChar(255)?
  email                    VarChar(255)
  encryptedPassword        VarChar(255)?          @map("encrypted_password")
  emailConfirmedAt         TimestamptzString(6)?  @map("email_confirmed_at")
  invitedAt                TimestamptzString(6)?  @map("invited_at")
  confirmationToken        VarChar(255)?          @map("confirmation_token")
  confirmationSentAt       TimestamptzString(6)?  @map("confirmation_sent_at")
  recoveryToken            VarChar(255)?          @map("recovery_token")
  recoverySentAt           TimestamptzString(6)?  @map("recovery_sent_at")
  emailChangeTokenNew      VarChar(255)?          @map("email_change_token_new")
  emailChange              VarChar(255)?          @map("email_change")
  emailChangeSentAt        TimestamptzString(6)?  @map("email_change_sent_at")
  lastSignInAt             TimestamptzString(6)?  @map("last_sign_in_at")
  rawAppMetaData           Jsonb?                 @map("raw_app_meta_data")
  rawUserMetaData          Jsonb?                 @map("raw_user_meta_data")
  isSuperAdmin             Boolean?               @map("is_super_admin")
  createdAt                TimestamptzString(6)?  @map("created_at")
  updatedAt                TimestamptzString(6)?  @map("updated_at")
  phone                    String?
  phoneConfirmedAt         TimestamptzString(6)?  @map("phone_confirmed_at")
  phoneChange              String?                @default("") @map("phone_change")
  phoneChangeToken         VarChar(255)?          @default("") @map("phone_change_token")
  phoneChangeSentAt        TimestamptzString(6)?  @map("phone_change_sent_at")
  emailChangeTokenCurrent  VarChar(255)?          @default("") @map("email_change_token_current")
  emailChangeConfirmStatus SmallInt?              @default(0) @map("email_change_confirm_status")
  bannedUntil              TimestamptzString(6)?  @map("banned_until")
  reauthenticationToken    VarChar(255)?          @default("") @map("reauthentication_token")
  reauthenticationSentAt   TimestamptzString(6)?  @map("reauthentication_sent_at")
  deletedAt                TimestamptzString(6)?  @map("deleted_at")
  authProvider             VarChar(32)?           @map("auth_provider")
  activities               Activity[]
  activityMigrationJobs    ActivityMigrationJob[]
  authExchanges            AuthExchange[]
  friends                  Friend[]
  profile                  Profile?
  userSessions             UserSession[]
  subscriptions            Subscription[]
  receivedNotifications    Notification[]      @relation("NotificationRecipient")
  sentNotifications       Notification[]      @relation("NotificationActor")
  pushDeviceTokens        PushDeviceToken[]
  submittedContentReports ContentReport[]    @relation("ContentReportReporter")
  reportedContentSubjects ContentReport[]    @relation("ContentReportSubject")
  assignedContentReports ContentReport[]     @relation("ContentReportAssignee")
  contentReportsForUser  ContentReport[]     @relation("ContentReportTargetUser")
  blocksCreated          UserBlock[]         @relation("UserBlockBlocker")
  blocksReceived         UserBlock[]         @relation("UserBlockBlocked")
  moderationActions      ModerationAction[]  @relation("ModerationActionActor")
  moderationAppeals      ModerationAppeal[]  @relation("ModerationAppealAppellant")
  reviewedModerationAppeals ModerationAppeal[] @relation("ModerationAppealReviewer")
  mediaModerationAssets  MediaModerationAsset[] @relation("MediaModerationAssetOwner")
  reviewedMediaModerationAssets MediaModerationAsset[] @relation("MediaModerationAssetReviewer")

  @@unique([email], map: "Users_email_key")
  @@unique([phone], map: "Users_phone_key")
  @@index(expression: sql`email gin_trgm_ops`, type: "gin", name: "Users_email_trgm_idx")
  @@map("Users")
}

model Profile {
  id                    Uuid                   @id(map: "Profile_pkey") @default(sql`gen_random_uuid()`)
  createdAt             TimestamptzString(6)   @default(now()) @map("created_at")
  name                  String?
  userId                Uuid                   @map("user_id")
  bio                   String?
  birthday              DateString?
  city                  String?
  gender                String?
  height                String?
  age                   String?
  restingHeartRate      String?                @map("resting_heart_rate")
  maxHeartRate          String?                @map("max_heart_rate")
  profilePhoto          String?
  sport                 String?
  surname               String?
  updatedAt             TimestamptzString(6)?
  weight                String?
  email                 String?
  language              String?
  emailNotifications    Boolean?               @default(false)
  pushNotifications     Boolean                 @default(false) @map("push_notifications")
  inAppNotifications    Boolean                 @default(true) @map("in_app_notifications")
  profilePhotoBlurhash  String?
  profileSearchVisible Boolean                @default(true) @map("profile_search_visible")
  allowActivityInteractions Boolean           @default(true) @map("allow_activity_interactions")
  allowActivityReplayViewing Boolean          @default(true) @map("allow_activity_replay_viewing")
  allowActivityHeartRateViewing Boolean       @default(true) @map("allow_activity_heart_rate_viewing")
  allowActivityElevationViewing Boolean       @default(true) @map("allow_activity_elevation_viewing")
  allowActivityPaceViewing Boolean            @default(true) @map("allow_activity_pace_viewing")
  allowActivitySharing Boolean                @default(true) @map("allow_activity_sharing")
  hideActivityStatistics Boolean              @default(false) @map("hide_activity_statistics")
  hideFollowingList Boolean                   @default(false) @map("hide_following_list")
  hideProfilePhotos Boolean                   @default(false) @map("hide_profile_photos")
  allowNewFollowers Boolean                   @default(true) @map("allow_new_followers")
  activities            Activity[]
  activityMigrationJobs ActivityMigrationJob[]
  comments              Comment[]
  commentLikes          CommentLike[]
  friends               Friend[]
  likes                 Like[]
  user                  User                   @relation(fields:[userId], references:[id], onDelete: Cascade, map: "Profile_user_id_fkey")

  @@unique([userId], map: "Profile_user_id_key")
  @@index(expression: sql`name gin_trgm_ops`, type: "gin", name: "Profile_name_trgm_idx")
  @@index(expression: sql`surname gin_trgm_ops`, type: "gin", name: "Profile_surname_trgm_idx")
  @@index(expression: sql`email gin_trgm_ops`, type: "gin", name: "Profile_email_trgm_idx")
  @@map("Profile")
}

enum ActivityVisibility {
  public
  followers
  private
}

enum ModerationContentStatus {
  visible
  hidden
  removed
}

enum ContentReportTargetType {
  activity
  comment
  media
  media_upload
  user
}

enum ContentReportReason {
  threats
  harassment
  hate_speech
  sexual_content
  violence
  spam
  other
}

enum ContentReportStatus {
  open
  in_review
  resolved
  rejected
  appealed
}

enum ModerationPriority {
  low
  normal
  high
  urgent
}

enum ModerationActionType {
  hide_content
  remove_content
  restore_content
  warn_user
  temporary_suspend
  permanent_suspend
  reject_report
  appeal_submitted
  appeal_upheld
  appeal_rejected
  approve_media
  reject_media
}

enum MediaModerationStatus {
  queued
  processing
  review_required
  approved
  rejected
  failed
}

enum ModerationAppealStatus {
  pending
  upheld
  rejected
}

model Activity {
  id                  Uuid                 @id(map: "Activity_pkey") @default(sql`gen_random_uuid()`)
  date                TimestamptzString(6) @default(now())
  timeZone            VarChar(64)?         @map("time_zone")
  createdAt           TimestamptzString(6) @default(now())
  updatedAt           TimestamptzString(6)
  description         String?
  distance            Float
  elevationGain       Float?
  duration            Int
  emotion             String?
  routeStorageKey     VarChar(512)?        @map("route_storage_key")
  routeFormatVersion  Int?                 @map("route_format_version")
  routePointCount     Int?                 @map("route_point_count")
  routeSizeBytes      Int?                 @map("route_size_bytes")
  routeChecksum       VarChar(64)?         @map("route_checksum")
  heartRateStorageKey VarChar(512)?        @map("heart_rate_storage_key")
  userId              Uuid                 @map("user_id")
  speed               Float
  sport               String
  title               String?
  kilometresSplit     Jsonb?
  mapPhotoUrl         String?
  routeOnlyMapPhotoUrl String?             @map("route_only_map_photo_url")
  mediaProcessingStatus VarChar(16)       @default("queued") @map("media_processing_status")
  locationName        String?             @map("location_name")
  weatherTemperature  Float?              @map("weather_temperature")
  weatherWindSpeed    Float?              @map("weather_wind_speed")
  weatherCode         Int?                @map("weather_code")
  caloriesActive      Int?                @map("calories_active")
  locationEnrichmentStatus VarChar(16)    @default("queued") @map("location_enrichment_status")
  visibility          ActivityVisibility   @default(public)
  hideMap             Boolean              @default(false) @map("hide_map")
  isFavorite          Boolean              @default(false) @map("is_favorite")
  mapPhotoUrlBlurhash String?
  profileId           Uuid
  source              VarChar(32)?
  sourceActivityId    VarChar(128)?
  steps               Int?
  averageHeartRate    Int?                 @map("average_heart_rate")
  minHeartRate        Int?                 @map("min_heart_rate")
  maxHeartRate        Int?                 @map("max_heart_rate")
  moderationStatus    ModerationContentStatus @default(visible) @map("moderation_status")
  comments            Comment[]
  likes               Like[]
  media               ActivityMedia[]
  contentReports      ContentReport[]      @relation("ContentReportActivity")
  profile             Profile              @relation(fields:[profileId], references:[id], onDelete: Cascade, map: "Activity_profileId_fkey", index: false)
  user                User                 @relation(fields:[userId], references:[id], onDelete: Cascade, map: "Activity_user_id_fkey", index: false)

  @@unique([userId, source, sourceActivityId], map: "Activity_user_id_source_sourceActivityId_key")
  @@index([userId, date, id], map: "Activity_user_id_date_id_idx")
  @@index([userId, visibility, date, id], map: "Activity_user_id_visibility_date_id_idx")
  @@index([visibility, date, id], map: "Activity_visibility_date_id_idx")
  @@map("Activity")
}

model ActivityMedia {
  id                          Uuid                     @id(map: "ActivityMedia_pkey") @default(sql`gen_random_uuid()`)
  activityId                  Uuid                     @map("activity_id")
  userId                      Uuid                     @map("user_id")
  activityDate                TimestamptzString(6)     @map("activity_date")
  position                    Int
  url                         String?
  thumbnail                   String?
  blurhash                    String?
  moderationStatus            ModerationContentStatus  @default(visible) @map("moderation_status")
  mediaModerationAssetId      Uuid?                    @unique @map("media_moderation_asset_id")
  thumbnailModerationAssetId  Uuid?                    @unique @map("thumbnail_moderation_asset_id")
  mediaReviewStatus           MediaModerationStatus?   @map("media_review_status")
  createdAt                   TimestamptzString(6)     @default(now()) @map("created_at")
  activity                    Activity                 @relation(fields:[activityId], references:[id], onDelete: Cascade, map: "ActivityMedia_activity_id_fkey", index: false)
  mediaModerationAsset        MediaModerationAsset?    @relation("ActivityMediaMediaAsset", fields:[mediaModerationAssetId], references:[id], onDelete: SetNull)
  thumbnailModerationAsset    MediaModerationAsset?    @relation("ActivityMediaThumbnailAsset", fields:[thumbnailModerationAssetId], references:[id], onDelete: SetNull)
  contentReports              ContentReport[]          @relation("ContentReportMedia")

  @@unique([activityId, position], map: "ActivityMedia_activity_id_position_key")
  @@index([userId, activityDate, activityId, position], map: "ActivityMedia_user_id_activity_date_idx")
  @@index([activityId], map: "ActivityMedia_activity_id_idx")
  @@map("ActivityMedia")
}

model ActivityMigrationJob {
  id                  Uuid                  @id(map: "ActivityMigrationJob_pkey") @default(sql`gen_random_uuid()`)
  userId              Uuid                  @map("user_id")
  profileId           Uuid
  archivePath         VarChar(2048)?
  status              VarChar(32)
  uploadBytesReceived Int                   @default(0) @map("upload_bytes_received")
  uploadBytesTotal    Int                   @default(0) @map("upload_bytes_total")
  uploadUpdatedAt     TimestamptzString(6)?  @map("upload_updated_at")
  totalActivities     Int                   @default(0)
  processedActivities Int                   @default(0)
  importedActivities  Int                   @default(0)
  skippedActivities   Int                   @default(0)
  errorMessage        String?
  createdAt           TimestamptzString(6)  @default(now())
  startedAt           TimestamptzString(6)?
  finishedAt          TimestamptzString(6)?
  profile             Profile               @relation(fields:[profileId], references:[id], onDelete: Cascade, map: "ActivityMigrationJob_profileId_fkey", index: false)
  user                User                  @relation(fields:[userId], references:[id], onDelete: Cascade, map: "ActivityMigrationJob_user_id_fkey", index: false)

  @@index([status, createdAt], map: "ActivityMigrationJob_status_createdAt_idx")
  @@index([userId, createdAt], map: "ActivityMigrationJob_user_id_createdAt_idx")
