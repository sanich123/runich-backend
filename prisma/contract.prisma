  @@unique([provider, providerSubscriptionId], map: "Subscriptions_provider_provider_subscription_id_key")
  @@index([userId, status, expiresAt], map: "Subscriptions_user_id_status_expires_at_idx")
  @@map("Subscriptions")
}

model AuthExchange {
  id         Uuid                  @id(map: "AuthExchange_pkey") @default(sql`gen_random_uuid()`)
