# 1. Проверка TypeScript
yarn typecheck

# 2. Линтинг и форматирование только подготовленных исходников
yarn lint-staged

# 3. Unit-тесты
yarn test:ci

# 4. Coverage-тесты с порогами покрытия
yarn test:cov

# 5. PostgreSQL integration/e2e-тесты
yarn db:up:check
yarn test:integration

# 6. Остановка локальной БД после успешного прохождения всех тестов
docker compose stop db

# 7. Production-сборка
yarn build

# 8. Проверка circular dependencies
yarn madge

# 9. Проверка неиспользуемых экспортов (Prisma/generated/d.ts исключены в package.json)
yarn ts-prune

# 10. Проверка неиспользуемых зависимостей (диагностическая)
yarn depcheck || true
